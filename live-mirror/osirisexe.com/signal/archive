<style>
:root {
  --green: #33ff66;
  --green-dim: #1d8f3f;
  --bg: #000;
  --card-w: min(58vw, 22rem);
  --ring-r: 48rem;
}
* { box-sizing: border-box; }
html {
  background: var(--bg);
}
html, body {
  margin: 0;
  min-height: 100vh;
  color: var(--green);
  font-family: "Courier New", Courier, monospace;
}
body {
  background: transparent;
  overflow: hidden;
  touch-action: none;
}
/* live shader background */
#bg {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: -2;
  pointer-events: none;
  background: #000;
}
/* dim overlay so HUD/cards stay readable */
#dim {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: rgba(0, 0, 0, 0.55);
}
/* CRT scanlines + vignette */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 50;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0) 0px,
    rgba(0, 0, 0, 0) 2px,
    rgba(0, 0, 0, 0.18) 3px
  );
  mix-blend-mode: multiply;
}
body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 51;
  pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
}
a { color: var(--green); text-decoration: none; }
a:hover { text-shadow: 0 0 8px var(--green); }

.hud {
  position: fixed;
  z-index: 60;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-shadow: 0 0 6px rgba(51, 255, 102, 0.5);
}
#hud-tl { top: 1rem; left: 1.25rem; }
#hud-tr { top: 1rem; right: 1.25rem; text-align: right; }
#hud-bl { bottom: 1rem; left: 1.25rem; }
#hud-br { bottom: 1rem; right: 1.25rem; text-align: right; }
.hud .dim { color: var(--green-dim); }
.blink { animation: blink 1.4s steps(2) infinite; }
@keyframes blink { 50% { opacity: 0; } }

.boot {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: grid;
  place-items: center;
  background: #000;
  animation: boot-away 0.8s 1.1s forwards;
}
.boot div {
  font-size: clamp(0.72rem, 3vw, 1rem);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  animation: boot-glitch 0.18s steps(2, end) infinite;
}
@keyframes boot-away { to { opacity: 0; visibility: hidden; } }
@keyframes boot-glitch { 50% { transform: translateX(2px); text-shadow: -2px 0 #fff; } }

.archive-shell {
  position: fixed;
  inset: 0;
  z-index: 2;
  display: grid;
  grid-template-rows: auto 1fr auto;
  padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
}
.topbar,
.bottombar {
  z-index: 61;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border: 1px solid rgba(51, 255, 102, 0.28);
  background: rgba(0, 0, 0, 0.64);
  padding: 0.65rem 0.8rem;
  font-size: clamp(0.58rem, 1.6vw, 0.76rem);
  letter-spacing: 0.09em;
  text-transform: uppercase;
}
.topbar strong { color: #d7ffe4; }
.rec-dot {
  display: inline-block;
  width: 0.55rem;
  height: 0.55rem;
  margin: 0 0.45rem;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px var(--green);
  animation: blink 1.2s steps(2, end) infinite;
}
.stage {
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
  perspective: 42em;
  cursor: grab;
  mask: linear-gradient(90deg, transparent, #000 12% 88%, transparent);
}
.stage.dragging { cursor: grabbing; }
.stage::before {
  content: "";
  position: absolute;
  inset: 8%;
  border: 1px solid rgba(51, 255, 102, 0.12);
  box-shadow: inset 0 0 80px rgba(51, 255, 102, 0.03);
  pointer-events: none;
}
.ring {
  display: grid;
  place-self: center;
  transform-style: preserve-3d;
  will-change: transform;
  transform: translateZ(calc(-1 * var(--ring-r))) rotateX(-4deg) rotateY(var(--rotation, 0deg));
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}
.card {
  --angle: calc(360deg / var(--count));
  grid-area: 1 / 1;
  display: block;
  width: var(--card-w);
  height: min(56vh, 30rem);
  margin: 0;
  border: 1px solid rgba(51, 255, 102, 0.42);
  border-radius: 0.28rem;
  background: #000;
  object-fit: contain;
  user-select: none;
  -webkit-user-drag: none;
  backface-visibility: hidden;
  filter: sepia(0.28) saturate(0.78) contrast(1.08) brightness(0.65);
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.9), 0 1.5rem 4rem rgba(0, 0, 0, 0.7), 0 0 1.5rem rgba(51, 255, 102, 0.08);
  transform: rotateY(calc(var(--index) * var(--angle))) translateZ(var(--ring-r));
  transition: filter 0.35s, border-color 0.35s;
}
.card.active {
  border-color: var(--green);
  filter: sepia(0.08) saturate(0.95) contrast(1.12) brightness(0.96);
}
.reticle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(72vw, 27rem);
  aspect-ratio: 1;
  translate: -50% -50%;
  border: 1px solid rgba(51, 255, 102, 0.18);
  pointer-events: none;
}
.status {
  position: absolute;
  left: 1rem;
  bottom: 1rem;
  max-width: min(42ch, 78vw);
  border-left: 2px solid var(--green);
  background: rgba(0, 0, 0, 0.72);
  padding: 0.6rem 0.75rem;
  font-size: clamp(0.6rem, 1.7vw, 0.78rem);
  line-height: 1.45;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  pointer-events: none;
}
.status b { color: #d7ffe4; }
.controls { display: flex; gap: 0.5rem; }
.control {
  appearance: none;
  border: 1px solid rgba(51, 255, 102, 0.28);
  background: #020503;
  color: var(--green);
  padding: 0.38rem 0.65rem;
  font: inherit;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
}
.control:hover,
.control:focus-visible,
.control:active { background: var(--green); color: #000; outline: none; }
.progress {
  min-width: 90px;
  height: 2px;
  flex: 1;
  overflow: hidden;
  background: rgba(51, 255, 102, 0.12);
}
.progress span {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--green);
  box-shadow: 0 0 10px var(--green);
  transform: scaleX(0.05);
  transform-origin: left;
  transition: transform 0.35s;
}
body > button[aria-pressed] {
  top: 50% !important;
  right: 0 !important;
  bottom: auto !important;
  transform: translateY(-50%) !important;
  writing-mode: vertical-rl !important;
}

@media (max-width: 700px) {
  :root { --card-w: min(69vw, 19rem); }
  .topbar span:nth-child(3),
  .bottombar > span:first-child { display: none; }
  .status { left: 0.5rem; bottom: 0.5rem; }
}
@media (prefers-reduced-motion: reduce) {
  .boot { display: none; }
  .rec-dot { animation: none; }
  .ring, .card, .progress span { transition: none; }
}

/* lightbox */
#lightbox {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: none;
  align-items: center;
  justify-content: center;
