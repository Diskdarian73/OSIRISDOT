// Combined archive carousel — preserves the original lightbox while adopting
// the artifact's rotating ring, drag/tap controls, and automatic advance.
const ring = document.getElementById('ring')
const stage = document.getElementById('stage')
const cards = [...document.querySelectorAll('.card')]
const progress = document.getElementById('progress')
const label = document.getElementById('fileLabel')
const signal = document.getElementById('signal')
const toggle = document.getElementById('toggle')
const lightbox = document.getElementById('lightbox')
const lbImg = lightbox.querySelector('img')
const lbCap = lightbox.querySelector('.caption')
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

let index = 0
let rotation = 0
let autoplay = !reducedMotion
let timer = null
const step = 360 / cards.length

function setRingRadius() {
  const cardWidth = Number.parseFloat(getComputedStyle(cards[0]).width)
  const radius = cardWidth / (2 * Math.tan(Math.PI / cards.length)) + 28
  document.documentElement.style.setProperty('--ring-r', radius + 'px')
}

function render() {
  rotation = -index * step
  ring.style.setProperty('--rotation', rotation + 'deg')
  cards.forEach((card, cardIndex) => card.classList.toggle('active', cardIndex === index))
  progress.style.transform = `scaleX(${(index + 1) / cards.length})`
  label.textContent = `RECOVERED ARCHIVE // ${cards[index].dataset.label}`
  signal.textContent = index % 3 === 2 ? 'RECONSTRUCTING' : 'CONTAINED'
  toggle.textContent = autoplay ? 'PAUSE' : 'PLAY'
  toggle.setAttribute('aria-pressed', autoplay ? 'true' : 'false')
}

function restart() {
  window.clearInterval(timer)
  if (autoplay) timer = window.setInterval(() => goTo(index + 1), 4200)
}

function goTo(nextIndex) {
  index = (nextIndex + cards.length) % cards.length
  render()
  restart()
}

function openLightbox() {
  const card = cards[index]
  lbImg.src = card.src
  lbImg.alt = card.alt
  lbCap.textContent = `RECOVERED ARCHIVE // ${card.dataset.label} // CLEARANCE: DISK`
  lightbox.classList.add('open')
}

function closeLightbox() {
  lightbox.classList.remove('open')
}

document.getElementById('next').addEventListener('click', () => goTo(index + 1))
document.getElementById('prev').addEventListener('click', () => goTo(index - 1))
toggle.addEventListener('click', () => {
  autoplay = !autoplay
  render()
  restart()
})

let dragging = false
let startX = 0
let startRotation = 0
let moved = 0
let downTarget = null

stage.addEventListener('pointerdown', event => {
  dragging = true
  startX = event.clientX
  startRotation = rotation
  moved = 0
  downTarget = event.target
  stage.classList.add('dragging')
  stage.setPointerCapture(event.pointerId)
  window.clearInterval(timer)
})
stage.addEventListener('pointermove', event => {
  if (!dragging) return
  moved = event.clientX - startX
  ring.style.setProperty('--rotation', startRotation + moved * 0.22 + 'deg')
})
function finishDrag(cancelled = false) {
  if (!dragging) return
  dragging = false
  stage.classList.remove('dragging')
  if (!cancelled && Math.abs(moved) > 35) {
    index = (index + (moved < 0 ? 1 : -1) + cards.length) % cards.length
  } else if (!cancelled && Math.abs(moved) < 10 && downTarget?.classList.contains('card')) {
    const tappedIndex = Number.parseInt(downTarget.style.getPropertyValue('--index'), 10)
    if (tappedIndex === index) openLightbox()
    else index = tappedIndex
  }
  render()
  restart()
}

stage.addEventListener('pointerup', () => finishDrag())
stage.addEventListener('pointercancel', () => finishDrag(true))

lightbox.addEventListener('click', event => {
  if (event.target === lightbox || event.target.classList.contains('lightbox-close')) closeLightbox()
})
window.addEventListener('keydown', event => {
  if (event.key === 'Escape') closeLightbox()
  else if (event.key === 'ArrowRight') goTo(index + 1)
  else if (event.key === 'ArrowLeft') goTo(index - 1)
  else if (event.key === 'Enter' && !lightbox.classList.contains('open')) openLightbox()
  else if (event.key === ' ') {
    event.preventDefault()
    autoplay = !autoplay
    render()
    restart()
  }
})
window.addEventListener('resize', setRingRadius)
window.setInterval(() => {
  document.getElementById('clock').textContent = new Date().toLocaleTimeString('en-US', {
    hour: '2-digit', minute: '2-digit', second: '2-digit'
  })
}, 1000)

setRingRadius()
render()
restart()
